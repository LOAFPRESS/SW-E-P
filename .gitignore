# Virtual environment (created with `python -m venv .venv`)
.venv/
venv/

# Python bytecode
__pycache__/
*.py[cod]

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
pytest-of-*/

# Pipeline outputs: reproducible, not source.  A curated sample run lives in
# docs/ for the report, but day-to-day artifacts stay untracked.
artifacts/
artifacts-*/
outputs/

# Local datasets: the Zenodo CSV files are large and must not be committed.
data/raw/
data/processed/
*.csv
!data/samples/*.csv

# Response cache and audit logs
*.sqlite3
requests.jsonl
run.log

# Secrets
.env
.env.*
*.key
